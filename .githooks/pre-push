#!/bin/sh

set -eu

configured_java_home="$(git config --local --get hooks.javaHome || true)"
if [ -n "$configured_java_home" ]; then
    export JAVA_HOME="$configured_java_home"
fi

if ! command -v mvn >/dev/null 2>&1; then
    echo "Pre-push quality gate failed: Maven is not available." >&2
    exit 1
fi

echo "Running pre-push code quality gate..."
mvn -DskipTests verify
